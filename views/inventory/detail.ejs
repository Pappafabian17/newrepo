<% if (title) { %>
<h1><%= title %></h1>
<% } %>

<% if (typeof messages === "function") { %>
  <%- messages() %>
<% } %>

<%- detail %>

<% if (typeof loggedin !== "undefined" && loggedin) { %>
  <div class="favorite-actions">
    <% if (isFavorite) { %>
      <form action="/favorites/remove" method="post">
        <input type="hidden" name="inv_id" value="<%= inv_id %>">
        <input type="hidden" name="source" value="detail">
        <button class="favorite-btn favorite-btn-remove" type="submit">Remove Favorite</button>
      </form>
    <% } else { %>
      <form action="/favorites/add" method="post">
        <input type="hidden" name="inv_id" value="<%= inv_id %>">
        <button class="favorite-btn favorite-btn-add" type="submit">Add to Favorites</button>
      </form>
    <% } %>
  </div>
<% } %>
