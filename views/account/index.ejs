<h1><%= title %></h1>

<% if (errors) { %>
  <ul class="notice">
    <% errors.array().forEach(error => { %>
      <li><%= error.msg %></li>
    <% }) %>
  </ul>
<% } %>

<% if (typeof messages === "function") { %>
  <%- messages() %>
<% } %>

<% if (accountData) { %>
  <h2>Welcome <%= accountData.account_firstname %></h2>
  <p>
    <a href="/account/update/<%= accountData.account_id %>" title="Update account information">Update Account Information</a>
  </p>
  <p>
    <a href="/favorites" title="View your favorite vehicles">My Favorites</a>
  </p>
  <% if (accountData.account_type === "Employee" || accountData.account_type === "Admin") { %>
    <h3>Inventory Management</h3>
    <p><a href="/inv/" title="Go to Inventory Management">Manage Inventory</a></p>
  <% } %>
<% } %>
