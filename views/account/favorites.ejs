<h1><%= title %></h1>

<% if (typeof messages === "function") { %>
  <%- messages() %>
<% } %>

<% if (favorites && favorites.length > 0) { %>
  <ul id="inv-display" class="favorites-grid">
    <% favorites.forEach(vehicle => { %>
      <li class="favorite-card">
        <a href="/inv/detail/<%= vehicle.inv_id %>" title="View <%= vehicle.inv_make %> <%= vehicle.inv_model %> details">
          <img src="<%= vehicle.inv_thumbnail %>" alt="Image of <%= vehicle.inv_make %> <%= vehicle.inv_model %>">
        </a>
        <div class="namePrice">
          <hr />
          <h2>
            <a href="/inv/detail/<%= vehicle.inv_id %>" title="View <%= vehicle.inv_make %> <%= vehicle.inv_model %> details">
              <%= vehicle.inv_make %> <%= vehicle.inv_model %>
            </a>
          </h2>
          <span class="favorite-price">$<%= new Intl.NumberFormat("en-US").format(vehicle.inv_price) %></span>
          <form action="/favorites/remove" method="post" class="favorite-inline-form">
            <input type="hidden" name="inv_id" value="<%= vehicle.inv_id %>">
            <input type="hidden" name="source" value="favorites">
            <button class="favorite-btn favorite-btn-remove" type="submit">Remove Favorite</button>
          </form>
        </div>
      </li>
    <% }) %>
  </ul>
<% } else { %>
  <p class="notice">You have no favorite vehicles yet.</p>
<% } %>
